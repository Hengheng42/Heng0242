generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────
enum Role {
  USER
  RESELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentChannel {
  KHQR
  ABA
  WING
  CARD
  WALLET
}

enum WalletTxType {
  TOPUP
  PURCHASE
  REFUND
  REFERRAL_BONUS
  ADJUSTMENT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  DEAD
}

// ───────────── Auth (NextAuth) ─────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  phone         String?
  locale        String    @default("km")
  currency      String    @default("USD")
  walletBalance Decimal   @default(0) @db.Decimal(12, 2)
  points        Int       @default(0)
  referralCode  String    @unique @default(cuid())
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")
  banned        Boolean   @default(false)
  telegramChatId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  walletTxs     WalletTransaction[]
  apiKeys       ApiKey[]
  activityLogs  ActivityLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────── Catalog ─────────────
model Game {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  publisher     String?
  description   String?  @db.Text
  descriptionKm String?  @db.Text
  coverUrl      String?
  iconUrl       String?
  currencyName  String   @default("Diamonds") // Diamonds, UC, Gems...
  // Input fields required from the buyer
  requiresZone  Boolean  @default(false)
  userIdLabel   String   @default("User ID")
  zoneIdLabel   String   @default("Zone ID")
  zoneOptions   Json?    // e.g. server list for games with fixed servers
  stockGameCode String?  // code used by the upstream StockProvider
  popular       Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  packages      Package[]
  orders        Order[]
  flashSales    FlashSale[]

  @@index([active, popular])
}

model Package {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name          String   // "86 Diamonds"
  amount        Int      // base amount
  bonus         Int      @default(0)
  costPrice     Decimal  @db.Decimal(12, 4) // what you pay upstream (USD)
  sellPrice     Decimal  @db.Decimal(12, 4) // retail (USD)
  originalPrice Decimal? @db.Decimal(12, 4) // strike-through price for discount badge
  stockSku      String?  // upstream product code
  bestSeller    Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tierPrices    ResellerTierPrice[]
  orders        Order[]
  flashSaleItems FlashSaleItem[]

  @@index([gameId, active])
}

model ResellerTier {
  id        String   @id @default(cuid())
  name      String   @unique // Bronze, Silver, Gold
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  minMonthlySpend Decimal @default(0) @db.Decimal(12, 2)
  prices    ResellerTierPrice[]
}

model ResellerTierPrice {
  id        String  @id @default(cuid())
  tierId    String
  packageId String
  price     Decimal @db.Decimal(12, 4)
  tier      ResellerTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([tierId, packageId])
}

model FlashSale {
  id        String   @id @default(cuid())
  title     String
  gameId    String?
  game      Game?    @relation(fields: [gameId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  items     FlashSaleItem[]
}

model FlashSaleItem {
  id          String  @id @default(cuid())
  flashSaleId String
  packageId   String
  salePrice   Decimal @db.Decimal(12, 4)
  stockLimit  Int?
  sold        Int     @default(0)
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, packageId])
}

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        DiscountType
  value       Decimal  @db.Decimal(12, 2)
  minOrder    Decimal? @db.Decimal(12, 2)
  maxDiscount Decimal? @db.Decimal(12, 2)
  usageLimit  Int?
  perUserLimit Int     @default(1)
  used        Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  active      Boolean  @default(true)
  orders      Order[]
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  placement String  @default("HOME_HERO") // HOME_HERO | HOME_PROMO
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model Testimonial {
  id       String  @id @default(cuid())
  name     String
  game     String?
  rating   Int     @default(5)
  content  String  @db.Text
  active   Boolean @default(true)
}

model Faq {
  id         String  @id @default(cuid())
  question   String
  questionKm String?
  answer     String  @db.Text
  answerKm   String? @db.Text
  sortOrder  Int     @default(0)
  active     Boolean @default(true)
}

model PaymentMethod {
  id        String         @id @default(cuid())
  channel   PaymentChannel @unique
  label     String
  feePercent Decimal       @default(0) @db.Decimal(5, 2)
  iconUrl   String?
  enabled   Boolean        @default(true)
  sortOrder Int            @default(0)
}

// ───────────── Orders & Payments ─────────────
model Order {
  id            String      @id @default(cuid())
  publicId      String      @unique // human friendly: DS-20261025-AB12CD
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  guestEmail    String?
  gameId        String
  game          Game        @relation(fields: [gameId], references: [id])
  packageId     String
  package       Package     @relation(fields: [packageId], references: [id])
  playerUserId  String
  playerZoneId  String?
  playerNickname String?
  quantity      Int         @default(1)
  currency      String      @default("USD")
  exchangeRate  Decimal     @default(1) @db.Decimal(12, 4)
  unitPrice     Decimal     @db.Decimal(12, 4)
  costPrice     Decimal     @db.Decimal(12, 4)
  discount      Decimal     @default(0) @db.Decimal(12, 4)
  fee           Decimal     @default(0) @db.Decimal(12, 4)
  total         Decimal     @db.Decimal(12, 4)
  profit        Decimal     @db.Decimal(12, 4)
  promoCodeId   String?
  promoCode     PromoCode?  @relation(fields: [promoCodeId], references: [id])
  status        OrderStatus @default(PENDING)
  failReason    String?
  stockOrderId  String?     // id returned by StockProvider
  idempotencyKey String?    @unique
  ip            String?
  userAgent     String?
  pointsEarned  Int         @default(0)
  viaApiKeyId   String?
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  completedAt   DateTime?
  updatedAt     DateTime    @updatedAt

  payments      Payment[]
  events        OrderEvent[]
  retryJobs     RetryJob[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([playerUserId])
  @@index([ip, createdAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  message   String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel       PaymentChannel
  providerRef   String?        @unique // id from PaymentProvider
  amount        Decimal        @db.Decimal(12, 4)
  currency      String         @default("USD")
  status        PaymentStatus  @default(PENDING)
  qrPayload     String?        @db.Text
  paymentUrl    String?
  expiresAt     DateTime?
  idempotencyKey String?       @unique
  rawResponse   Json?
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  updatedAt     DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   // dedupe key from provider
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
}

model RetryJob {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String    // STOCK_CREATE | STOCK_POLL | REFUND
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  nextRunAt   DateTime  @default(now())
  lastError   String?
  status      JobStatus @default(QUEUED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRunAt])
}

// ───────────── Wallet / Loyalty / Reseller ─────────────
model WalletTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      WalletTxType
  amount    Decimal      @db.Decimal(12, 2) // positive = credit, negative = debit
  balanceAfter Decimal   @db.Decimal(12, 2)
  reference String?      // order publicId / payment id
  note      String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String
  keyHash    String    @unique // sha256 of the full key; full key shown once
  rateLimitPerMin Int  @default(60)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ───────────── Security / Admin ─────────────
model Blacklist {
  id        String   @id @default(cuid())
  type      String   // IP | EMAIL | PLAYER_ID | USER
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model IdempotencyKey {
  key         String   @id
  scope       String   // e.g. "order.create"
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // e.g. "order.refund", "package.update"
  entity    String?  // "Order" | "Package" ...
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
